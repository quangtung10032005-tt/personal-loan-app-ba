<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER GRADIENT -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="80dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <!-- Badge Chào buổi sáng -->
            <LinearLayout
                android:id="@+id/badgeGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_greeting_badge"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌅"
                    android:textSize="14sp"
                    android:layout_marginRight="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vay vốn và chi tiêu cá nhân"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- User Info & Notification -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/badgeGreeting">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhóm 2"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:id="@+id/btnNotification"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell" />

                        <TextView
                            android:id="@+id/tvNotificationBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/circle_dot"
                            android:backgroundTint="#FF4444"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvAvatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="N"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <!-- CONTENT (overlapping header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginTop="-56dp">

            <!-- Date Card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_date_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_centerVertical="true">

                    <View
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icon_calendar_blue"
                        android:layout_marginRight="16dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hôm nay"
                            android:textSize="13sp"
                            android:textColor="@color/gray_500"/>

                        <TextView
                            android:id="@+id/tvCurrentDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thứ 2, 1 tháng 1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800"/>

                        <TextView
                            android:id="@+id/tvCurrentYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Năm 2026"
                            android:textSize="11sp"
                            android:textColor="@color/gray_400"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Smart badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_smart_badge"
                    android:padding="12dp"
                    android:gravity="center"
                    android:minWidth="85dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="18sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chi tiêu\nthông minh"
                        android:textSize="11sp"
                        android:textColor="#42965F"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- Net Balance Section -->
            <LinearLayout
                android:id="@+id/layoutNetBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số dư ròng (Tháng này)"
                    android:textSize="14sp"
                    android:textColor="@color/gray_500"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvNetBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentRight="true"
                        android:gravity="right">

                        <TextView
                            android:id="@+id/tvIncomeMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thu: 0đ"
                            android:textSize="13sp"
                            android:textColor="@color/gray_500"/>

                        <TextView
                            android:id="@+id/tvExpenseMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chi: 0đ"
                            android:textSize="13sp"
                            android:textColor="@color/gray_500"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- Thêm tổng tiền vay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:paddingTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng tiền vay (Còn lại)"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"/>

                    <TextView
                        android:id="@+id/tvTotalLoan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#D32F2F"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_progress_track"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="24dp"
                android:layout_marginBottom="24dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="18sp"
                        android:layout_marginRight="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thao tác nhanh"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"/>
                </LinearLayout>

                <!-- 2x2 Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Thêm thu nhập -->
                    <LinearLayout
                        android:id="@+id/btnAddIncome"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_quick_action_blue_light"
                        android:layout_marginRight="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💵"
                            android:textSize="24sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thêm thu nhập"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue_card_text"/>
                    </LinearLayout>

                    <!-- Thêm chi tiêu -->
                    <LinearLayout
                        android:id="@+id/btnAddExpense"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_quick_action_green"
                        android:layout_marginLeft="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰"
                            android:textSize="24sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thêm chi tiêu"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/green_text"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Tạo ngân sách -->
                    <LinearLayout
                        android:id="@+id/btnCreateBudget"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_quick_action_blue"
                        android:layout_marginRight="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="24sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tạo ngân sách"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue_card_text"/>
                    </LinearLayout>

                    <!-- Xem báo cáo -->
                    <LinearLayout
                        android:id="@+id/btnViewReport"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_quick_action_orange"
                        android:layout_marginLeft="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈"
                            android:textSize="24sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem báo cáo"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/orange_text"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Tổng quan nhanh -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tổng quan nhanh"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/gray_800"
                android:layout_marginBottom="16dp"
                android:paddingLeft="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Hôm nay -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="20dp"
                    android:layout_marginRight="8dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="28dp">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_red"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VND"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/red_icon"
                            android:layout_gravity="top"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hôm nay"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTodayTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"/>
                </LinearLayout>

                <!-- Tháng này -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="20dp"
                    android:layout_marginLeft="8dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="28dp">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_orange"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VND"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/orange_text"
                            android:layout_gravity="top"
                            android:layout_marginLeft="8dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tháng này"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvMonthTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Budget Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingLeft="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngân sách"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/tvViewAllBudgets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:layout_marginRight="12dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvCreateNewBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tạo mới"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngân sách"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"/>

                    <TextView
                        android:id="@+id/tvBudgetStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa chi"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/report_green_text"
                        android:background="@drawable/bg_budget_status"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_alignParentRight="true"/>

                    <TextView
                        android:id="@+id/tvBudgetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngân sách tháng --/----"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"
                        android:layout_marginTop="20dp"/>
                </RelativeLayout>

                <!-- Row: Total -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/icTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔵"
                        android:textSize="16sp"
                        android:layout_marginRight="8dp"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng:"
                        android:textSize="15sp"
                        android:textColor="@color/gray_700"
                        android:layout_toRightOf="@id/icTotal"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/tvBudgetTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>

                <!-- Row: Previous Balance -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số dư tháng trước:"
                        android:textSize="15sp"
                        android:textColor="@color/gray_500"
                        android:layout_marginLeft="28dp"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/tvPrevMonthBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_100"
                    android:layout_marginBottom="16dp"/>

                <!-- Row: Remaining -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/icRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👛"
                        android:textSize="16sp"
                        android:layout_marginRight="8dp"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Còn lại:"
                        android:textSize="15sp"
                        android:textColor="@color/gray_700"
                        android:layout_toRightOf="@id/icRemaining"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/tvBudgetRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/report_green_text"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_progress_track"
                    android:layout_marginBottom="16dp"/>

                <!-- Info Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_budget_info"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:text="ℹ️"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginRight="10dp"/>

                    <TextView
                        android:id="@+id/tvBudgetInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Số dự phòng: Dự kiến tiết kiệm được ₫0 trong tháng này"
                        android:textSize="12sp"
                        android:textColor="@color/gray_800"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Recent Expenses -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:paddingLeft="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chi tiêu gần đây"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800"/>

                <TextView
                    android:id="@+id/tvViewAllExpenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
