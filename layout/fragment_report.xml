<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Báo cáo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/gray_800"
            android:layout_centerInParent="true"/>

        <LinearLayout
            android:id="@+id/layoutMonthFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_filter_inactive"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center">
            <TextView
                android:id="@+id/tvCurrentMonthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tháng ..."
                android:textSize="14sp"
                android:textColor="@color/gray_800"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/arrow_down_float"
                android:layout_marginStart="4dp"
                android:alpha="0.6"/>
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Summary Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="20dp"
                    android:layout_marginRight="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tổng chi tiêu" android:textSize="13sp" android:textColor="@color/gray_500"/>
                    <TextView android:id="@+id/tvTotalSpend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.915.000đ" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/gray_800" android:layout_marginTop="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="20dp"
                    android:layout_marginLeft="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giao dịch" android:textSize="13sp" android:textColor="@color/gray_500"/>
                    <TextView android:id="@+id/tvTotalCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19 giao dịch" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/gray_800" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Month Comparison Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_green"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Left Column -->
                    <LinearLayout
                        android:id="@+id/layoutLeftHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="So sánh tháng"
                            android:textStyle="bold"
                            android:textColor="@color/report_green_text"
                            android:textSize="15sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="so với tháng trước"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Right Column -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:id="@+id/tvComparisonStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chi tiêu tăng"
                            android:textSize="13sp"
                            android:textColor="@color/gray_500"/>
                        <TextView
                            android:id="@+id/tvComparisonPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+957.0%"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/report_green_text"
                            android:layout_marginTop="2dp"/>
                        <TextView
                            android:id="@+id/tvPrevMonthCompSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="465.000đ"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginTop="2dp"/>
                        <TextView
                            android:id="@+id/tvIncreaseLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tăng 957.0%"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Large label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chi tiêu"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"
                        android:textSize="22sp"
                        android:layout_below="@id/layoutLeftHeader"
                        android:layout_marginTop="12dp"/>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_white"
                        android:padding="20dp"
                        android:gravity="center"
                        android:layout_marginRight="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng trước" android:textSize="13sp" android:textColor="@color/gray_400"/>
                        <TextView android:id="@+id/tvPrevMonthSpend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="465.000đ" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/report_blue_text" android:layout_marginTop="10dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_white"
                        android:padding="20dp"
                        android:gravity="center"
                        android:layout_marginLeft="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng này" android:textSize="13sp" android:textColor="@color/gray_400"/>
                        <TextView android:id="@+id/tvThisMonthSpendComp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.915.000đ" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/report_orange_text" android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Comparison Bar Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Biểu đồ so sánh" android:textSize="13sp" android:textColor="@color/gray_500"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng trước vs Tháng này" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gray_800" android:layout_marginTop="4dp"/>

                <!-- Dummy Bar Chart -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="20dp"
                    android:paddingHorizontal="40dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <View
                            android:id="@+id/barPrevMonth"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@color/chart_blue"
                            android:backgroundTint="#4A85F6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng trước" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <View
                            android:id="@+id/barThisMonth"
                            android:layout_width="40dp"
                            android:layout_height="140dp"
                            android:background="@color/chart_orange"
                            android:backgroundTint="#F0943A"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tháng này" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="So sánh theo danh mục" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gray_800" android:layout_marginBottom="16dp" android:layout_marginTop="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryComparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp"/>

            <!-- Distribution Pie Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xu hướng chi tiêu" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gray_800" android:layout_marginBottom="16dp"/>

                <!-- Dummy Trend Chart (3 months) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingHorizontal="20dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/barTrend1" android:layout_width="40dp" android:layout_height="30dp" android:background="@color/chart_blue" android:backgroundTint="#4A85F6" android:alpha="0.8"/>
                        <TextView android:id="@+id/tvTrendLabel1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Th 4" android:textSize="10sp" android:layout_marginTop="8dp"/>
                        <TextView android:id="@+id/tvTrendValue1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0đ" android:textSize="10sp" android:textColor="@color/gray_400"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/barTrend2" android:layout_width="40dp" android:layout_height="30dp" android:background="@color/chart_blue" android:backgroundTint="#4A85F6" android:alpha="0.8"/>
                        <TextView android:id="@+id/tvTrendLabel2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Th 5" android:textSize="10sp" android:layout_marginTop="8dp"/>
                        <TextView android:id="@+id/tvTrendValue2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0đ" android:textSize="10sp" android:textColor="@color/gray_400"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/barTrend3" android:layout_width="40dp" android:layout_height="80dp" android:background="@color/chart_blue" android:backgroundTint="#4A85F6"/>
                        <TextView android:id="@+id/tvTrendLabel3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Th 6" android:textSize="10sp" android:layout_marginTop="8dp"/>
                        <TextView android:id="@+id/tvTrendValue3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.915k" android:textSize="10sp" android:textColor="@color/gray_400"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhấn vào cột để xem chi tiết" android:textSize="12sp" android:textColor="@color/gray_400" android:gravity="center" android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Distribution Pie Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phân bổ chi tiêu theo danh mục" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gray_800" android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Custom Donut Chart -->
                    <FrameLayout
                        android:layout_width="140dp"
                        android:layout_height="140dp">
                        <com.example.cuoi_ky.DonutChartView
                            android:id="@+id/donutChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="center"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tổng" android:textSize="12sp" android:textColor="@color/gray_400"/>
                            <TextView android:id="@+id/tvDonutTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0đ" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/gray_800"/>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Legend -->
                    <LinearLayout
                        android:id="@+id/layoutLegend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="24dp">
                        <!-- Items will be added dynamically -->
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- List of Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:layout_marginBottom="80dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chi tiêu theo danh mục" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gray_800" android:layout_marginBottom="16dp"/>

                <TextView android:id="@+id/tvListTotalHeader"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tổng: 0đ" android:textSize="16sp"
                    android:textColor="@color/gray_400"
                    android:layout_marginBottom="20dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategoryReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
