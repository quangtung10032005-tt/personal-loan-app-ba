<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:id="@+id/cardPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_white"
        android:padding="20dp"
        android:elevation="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvItemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kế hoạch chi tiêu"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800"/>
                <TextView
                    android:id="@+id/tvItemBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngân sách: 0đ"
                    android:textSize="13sp"
                    android:textColor="@color/gray_400"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHỌN"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_400"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:letterSpacing="0.1"/>
        </RelativeLayout>

        <!-- Thêm RecyclerView con để hiện danh sách danh mục -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItemCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="right">

        <TextView
            android:id="@+id/btnEditPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa"
            android:textSize="12sp"
            android:textColor="@color/loan_green"
            android:padding="8dp"
            android:layout_marginRight="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnDeletePlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa kế hoạch"
            android:textSize="12sp"
            android:textColor="@color/danger"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
